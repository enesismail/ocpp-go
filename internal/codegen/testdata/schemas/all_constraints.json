{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "$id": "urn:OCPP:Cp:2:2020:3:all_constraints",
  "title": "all_constraints",
  "type": "object",
  "properties": {
    "text": {"type": "string", "format": "date-time", "minLength": 1, "maxLength": 32, "pattern": "^[a-z]+$"},
    "number": {"type": "number", "minimum": 0, "maximum": 99, "exclusiveMinimum": 0, "exclusiveMaximum": 99},
    "list": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string"}}
  },
  "required": ["text", "number"],
  "definitions": {}
}
